# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string (MongoDB Atlas or local, e.g. mongodb://127.0.0.1:27017/hirenest)
MONGO_URI=

# Port the API listens on (the frontend expects 8000 by default)
PORT=8000

# Secret used to sign login tokens: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=

# Cloudinary account (stores profile photos, company logos and resumes)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Frontend URL(s) allowed to call the API with cookies (comma-separated, no trailing slash)
FRONTEND_URL=http://localhost:5173

# --- Production only ---
# NODE_ENV=production        # secure cookies (HTTPS) for a frontend on a different domain
# TRUST_PROXY=1              # set when running behind a proxy/load balancer (Render, Railway, Nginx)

# --- Optional ---
# AUTH_RATE_LIMIT=20         # login/register attempts per 15 min per IP (raise only for local test runs)
